[Unit]
Description=@DISPLAY_NAME@ measurement core and WebUI
After=local-fs.target network.target
RequiresMountsFor=/var/lib/@PACKAGE@

[Service]
Type=exec
User=@SERVICE_USER@
Group=@SERVICE_USER@
SupplementaryGroups=dialout
StateDirectory=@PACKAGE@
StateDirectoryMode=0700
WorkingDirectory=/var/lib/@PACKAGE@
UMask=0077
ExecStartPre=/usr/lib/@PACKAGE@/prepare-archive
ExecStart=/usr/lib/@PACKAGE@/ori-supervisor run /etc/@PACKAGE@/supervisor.json
ExecStartPost=/usr/lib/@PACKAGE@/wait-ready
ExecStop=/usr/lib/@PACKAGE@/ori-supervisor shutdown /var/lib/@PACKAGE@
TimeoutStartSec=150
TimeoutStopSec=150
Restart=on-failure
RestartSec=5
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
