#!/bin/sh
set -eu
# The admin socket authenticates the peer UID and checks the owned backend PID.
# Wait for the supervisor to create its private state before the first probe.
data=/var/lib/@PACKAGE@
while [ ! -S "$data/.ori-runtime/supervisor.sock" ] ||
        ! /usr/lib/@PACKAGE@/ori-supervisor status "$data" >/dev/null 2>&1; do
    sleep 1
done
