[Unit]
Description=OpenRadioInspector Pi RC measurement core and WebUI
After=local-fs.target network.target
RequiresMountsFor=/var/lib/openradioinspector-pi-rc

[Service]
Type=exec
User=ori-pi-rc
Group=ori-pi-rc
SupplementaryGroups=dialout
StateDirectory=openradioinspector-pi-rc
StateDirectoryMode=0700
WorkingDirectory=/var/lib/openradioinspector-pi-rc
UMask=0077
ExecStartPre=/usr/lib/openradioinspector-pi-rc/prepare-archive
ExecStart=/usr/lib/openradioinspector-pi-rc/ori-supervisor run /etc/openradioinspector-pi-rc/supervisor.json
ExecStartPost=/usr/lib/openradioinspector-pi-rc/wait-ready
ExecStop=/usr/lib/openradioinspector-pi-rc/ori-supervisor shutdown /var/lib/openradioinspector-pi-rc
TimeoutStartSec=150
TimeoutStopSec=150
Restart=on-failure
RestartSec=5
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
