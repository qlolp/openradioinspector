{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The local window uses the selected node transport and the installed per-user supervisor.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-local-node",
    "allow-choose-local-archive-directory",
    "allow-connect-node",
    "allow-pair-node",
    "allow-revoke-pairing",
    "allow-api-request",
    "allow-cancel-request",
    "allow-start-events",
    "allow-stop-events",
    "allow-ack-event",
    "allow-open-legacy"
  ]
}
